## WORMS for helping out with testing              ## ## if you dont have  ##
##################################################### ## names in you're   ##
## The VFIO community for using the scripts and    ## ## lspci feedback    ##
## testing them for us!                            ## ## in your terminal  ##
##################################################### #######################

################################# Variables #################################

## Adds current time to var for use in echo for a cleaner log and script ##
DATE=$(date +"%m/%d/%Y %R:%S :")

GPU_PCI="0000:01:00.0"
GPU_AUDIO_PCI="0000:01:00.1"

clear_driver_override() {
    local pci="$1"

    if [ -e "/sys/bus/pci/devices/${pci}/driver_override" ]; then
        echo > "/sys/bus/pci/devices/${pci}/driver_override"
    fi
}

unbind_if_bound() {
    local pci="$1"

    if [ -L "/sys/bus/pci/devices/${pci}/driver" ]; then
        echo "$pci" > "/sys/bus/pci/devices/${pci}/driver/unbind" 2>/dev/null || true
    fi
}

probe_pci_device() {
    local pci="$1"

    if [ -e "/sys/bus/pci/devices/${pci}" ]; then
        echo "$pci" > /sys/bus/pci/drivers_probe 2>/dev/null || true
    fi
}

################################## Script ###################################

echo "$DATE Beginning of Teardown!"

## Unload VFIO-PCI driver ##
modprobe -r vfio_pci
modprobe -r vfio_iommu_type1
modprobe -r vfio

if grep -q "true" "/tmp/vfio-is-nvidia" ; then

    ## Load NVIDIA drivers ##
    echo "$DATE Loading NVIDIA GPU Drivers"

    ## Avoid virsh from inside the libvirt release hook. Rebind via sysfs so
    ## teardown cannot deadlock libvirt while destroy/shutdown is completing.
    unbind_if_bound "$GPU_PCI"
    unbind_if_bound "$GPU_AUDIO_PCI"
    clear_driver_override "$GPU_PCI"
    clear_driver_override "$GPU_AUDIO_PCI"

    modprobe nvidia
    modprobe nvidia_modeset
    modprobe nvidia_uvm
    modprobe nvidia_drm
    modprobe i2c_nvidia_gpu
    modprobe snd_hda_intel

    probe_pci_device "$GPU_PCI"
    probe_pci_device "$GPU_AUDIO_PCI"

    echo "$DATE NVIDIA GPU Drivers Loaded"
fi

if  grep -q "true" "/tmp/vfio-is-amd" ; then

    ## Load NVIDIA drivers ##
    echo "$DATE Loading AMD GPU Drivers"
    
    modprobe drm
    modprobe amdgpu
    modprobe radeon
    modprobe drm_kms_helper
    
    echo "$DATE AMD GPU Drivers Loaded"
fi

############################################################################################################
## Rebind VT consoles (adapted and modernised from https://www.kernel.org/doc/Documentation/fb/fbcon.txt) ##
############################################################################################################

input="/tmp/vfio-bound-consoles"
if [ -f "$input" ]; then
    while read -r consoleNumber; do
      if test -x /sys/class/vtconsole/vtcon"${consoleNumber}"; then
          if [ "$(grep -c "frame buffer" "/sys/class/vtconsole/vtcon${consoleNumber}/name")" \
               = 1 ]; then
        echo "$DATE Rebinding console ${consoleNumber}"
          echo 1 > /sys/class/vtconsole/vtcon"${consoleNumber}"/bind
          fi
      fi
    done < "$input"
fi

## Stop VNC lifeline now that the host display is coming back ##
echo "$DATE Stopping VNC Remote"
su - snekux -c "/usr/local/bin/vnc-remote stop" || true

## Restart Display Manager ##
echo "$DATE Restarting Display Manager"
systemctl isolate graphical.target

## Restore Host CPU Resources ##
# Restore all cores to the host
echo "$DATE Restoring all CPU cores..."
systemctl set-property --runtime --all user.slice AllowedCPUs=0-23
systemctl set-property --runtime --all system.slice AllowedCPUs=0-23
systemctl set-property --runtime --all init.scope AllowedCPUs=0-23

## CPU Governor: Restore all cores to powersave ##
echo "$DATE Restoring CPU governor to 'powersave' for all cores..."
for i in $(seq 0 23); do
    echo "powersave" > /sys/devices/system/cpu/cpu${i}/cpufreq/scaling_governor
done
echo "$DATE CPU governor restored to 'powersave'."

## Hugepages: Release pool and restore VM RAM to 48GB for next session ##
echo "$DATE Releasing hugepages..."
echo 0 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages
echo "$DATE Hugepages released."

# Avoid virsh calls from teardown. The nohyper recovery startup does not rewrite
# VM RAM, so this stale marker can only make release cleanup less reliable.
if [ -f /tmp/vfio-restore-vm-ram ]; then
    rm -f /tmp/vfio-restore-vm-ram
    echo "$DATE Removed stale VM RAM restore marker."
fi

echo "$DATE Restarting CoolerControl for Host mode..."
systemctl --no-block restart coolercontrold.service

echo "$DATE End of Teardown!"
