################################# Variables #################################

## Adds current time to var for use in echo for a cleaner log and script ##
DATE=$(date +"%m/%d/%Y %R:%S :")

## Sets dispmgr var as null ##
DISPMGR="null"

################################## Script ###################################

echo "$DATE Beginning of Startup!"

##Stop Display Manager ##
echo "$DATE Stopping Display Manager and Graphical Sessions..."
if systemctl is-active --quiet sddm.service; then
   systemctl stop sddm.service
fi
systemctl isolate multi-user.target

# Terminate all graphical sessions on seat0 to gracefully kill KDE Wayland
loginctl terminate-seat seat0 2>/dev/null || true

echo "$DATE Waiting for user sessions and Wayland to fully terminate..."
max_wait=15
count=0
# logind revokes the DRM FDs instantly, so lsof won't work. We must wait for the actual compositor to die.
while pidof kwin_wayland plasmashell Xwayland >/dev/null 2>&1; do
    sleep 1
    count=$((count+1))
    if [ $count -ge $max_wait ]; then
        echo "$DATE Timeout reached! Force killing Wayland processes..."
        killall -9 kwin_wayland plasmashell Xwayland >/dev/null 2>&1
        
        # Explicitly kill aggressive apps that survive the KDE session crash and migrate to the VNC server
        echo "$DATE Killing lingering user applications (Steam, Discord)..."
        pkill -u snekux -f -i "steam" >/dev/null 2>&1 || true
        pkill -u snekux -f -i "discord" >/dev/null 2>&1 || true
        
        sleep 2
        break
    fi
done

# Secondary safety check to ensure absolutely no processes are holding the GPU before we unload
if [ -n "$(lsof /dev/nvidia* /dev/dri/card* /dev/dri/renderD* 2>/dev/null)" ]; then
    echo "$DATE Killing lingering unknown processes using the GPU..."
    fuser -k -9 /dev/nvidia* /dev/dri/card* /dev/dri/renderD* >/dev/null 2>&1
    sleep 1
fi

# Unbind EFI-framebuffer
if [ -d "/sys/bus/platform/drivers/efi-framebuffer" ]; then
    echo "efi-framebuffer.0" > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
fi

## Clear previous state files ##
rm -f /tmp/vfio-is-nvidia /tmp/vfio-is-amd /tmp/vfio-bound-consoles

sleep "1"

##############################################################################################################################
## Unbind VTconsoles if currently bound (adapted and modernised from https://www.kernel.org/doc/Documentation/fb/fbcon.txt) ##
##############################################################################################################################
if test -e "/tmp/vfio-bound-consoles"; then
    rm -f /tmp/vfio-bound-consoles
fi
for (( i = 0; i < 16; i++))
do
  if test -x /sys/class/vtconsole/vtcon"${i}"; then
      if [ "$(grep -c "frame buffer" /sys/class/vtconsole/vtcon"${i}"/name)" = 1 ]; then
	       echo 0 > /sys/class/vtconsole/vtcon"${i}"/bind
           echo "$DATE Unbinding Console ${i}"
           echo "$i" >> /tmp/vfio-bound-consoles
      fi
  fi
done

sleep "1"

if lspci -nn | grep -e VGA | grep -s NVIDIA ; then
    echo "$DATE System has an NVIDIA GPU"
    echo "true" > /tmp/vfio-is-nvidia

    ## Unload NVIDIA GPU drivers ##
    echo "$DATE Unloading NVIDIA drivers..."
    unload_success=0
    for i in {1..15}; do
        if modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia i2c_nvidia_gpu >/dev/null 2>&1; then
            unload_success=1
            break
        else
            echo "$DATE Drivers still in use. Force killing lingering apps (Attempt $i/15)..."
            fuser -k -9 /dev/nvidia* /dev/dri/card* /dev/dri/renderD* >/dev/null 2>&1
            sleep 2
        fi
    done

    if [ "$unload_success" -eq 0 ]; then
        echo "$DATE FATAL ERROR: Failed to unload NVIDIA drivers."
        echo "$DATE Processes still using GPU:"
        lsof /dev/nvidia* /dev/dri/card* /dev/dri/renderD*
        echo "$DATE Aborting VM startup to prevent host kernel panic!"
        systemctl isolate graphical.target
        exit 1
    fi

    ## Detach RTX 4080 from host drivers ##
    virsh nodedev-detach pci_0000_01_00_0
    virsh nodedev-detach pci_0000_01_00_1

    echo "$DATE NVIDIA GPU Drivers Unloaded"
fi

if lspci -nn | grep -e VGA | grep -s AMD ; then
    echo "$DATE System has an AMD GPU"
    grep -qsF "true" "/tmp/vfio-is-amd" || echo "true" >/tmp/vfio-is-amd
    echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind

    ## Unload AMD GPU drivers ##
    modprobe -r drm_kms_helper
    modprobe -r amdgpu
    modprobe -r radeon
    modprobe -r drm

    echo "$DATE AMD GPU Drivers Unloaded"
fi

## Load VFIO-PCI driver ##
modprobe vfio
modprobe vfio_pci
modprobe vfio_iommu_type1

## Host CPU Isolation ##
# Isolate P-cores (0-15) by moving host processes to E-cores (16-23)
echo "$DATE Isolating P-cores..."
systemctl set-property --runtime --all user.slice AllowedCPUs=16-23
systemctl set-property --runtime --all system.slice AllowedCPUs=16-23
systemctl set-property --runtime --all init.scope AllowedCPUs=16-23

## CPU Governor: Switch VM cores to performance for full turbo boost ##
echo "$DATE Setting CPU governor to 'performance' for VM cores (0-15)..."
for i in $(seq 0 15); do
    echo "performance" > /sys/devices/system/cpu/cpu${i}/cpufreq/scaling_governor
done
echo "$DATE CPU governor set to 'performance'."

## Hugepages: fixed 32GB 2MB hugepage reservation for VM ##
# win11-outlawsHV.xml now requests 32GB RAM backed by explicit 2MB hugepages.
# Do not rewrite the inactive libvirt XML here; if the host cannot reserve the
# full pool, abort cleanly before QEMU starts so the VM definition stays stable.
HP_TARGET=16384           # 16384 x 2MB = 32GB
HP_PATH=/sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages

echo "$DATE Compacting host memory to reduce fragmentation before hugepage allocation..."
# compact_memory is asynchronous — poll HugePages_Free until it stops rising.
echo 1 > /proc/sys/vm/compact_memory
prev_free="-1"
for i in $(seq 1 12); do
    sleep 5
    curr_free=$(grep -m1 'HugePages_Free' /proc/meminfo | awk '{print $2}')
    echo "$DATE  [compact pass $i] HugePages_Free=${curr_free}"
    if [ "$curr_free" = "$prev_free" ] && [ "$i" -ge 2 ]; then
        echo "$DATE  Compaction stabilised after $((i * 5))s."
        break
    fi
    prev_free="$curr_free"
done

echo "$DATE Requesting ${HP_TARGET} hugepages..."
echo "$HP_TARGET" > "$HP_PATH"
sleep 3
HP_ACTUAL=$(cat "$HP_PATH")
echo "$DATE First pass: ${HP_ACTUAL} / ${HP_TARGET} pages allocated."

# Second compaction pass if we fell short.
if [ "$HP_ACTUAL" -lt "$HP_TARGET" ]; then
    echo "$DATE Running second compaction pass and retrying..."
    echo 1 > /proc/sys/vm/compact_memory
    sleep 10
    echo "$HP_TARGET" > "$HP_PATH"
    sleep 3
    HP_ACTUAL=$(cat "$HP_PATH")
    echo "$DATE Second pass: ${HP_ACTUAL} / ${HP_TARGET} pages allocated."
fi

HP_ACTUAL_KiB=$(( HP_ACTUAL * 2048 ))  # 1 hugepage = 2MB = 2048 KiB
echo "$DATE Final: ${HP_ACTUAL} hugepages = $(( HP_ACTUAL * 2 / 1024 ))GB."

if [ "$HP_ACTUAL" -lt "$HP_TARGET" ]; then
    echo "$DATE FATAL ERROR: Only ${HP_ACTUAL} / ${HP_TARGET} hugepages allocated."
    echo "$DATE Releasing hugepage pool and aborting VM startup to avoid partial RAM/XML state."
    echo 0 > "$HP_PATH"
    rm -f /tmp/vfio-restore-vm-ram
    echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
    echo always > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true
    systemctl isolate graphical.target
    exit 1
else
    echo never > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
    rm -f /tmp/vfio-restore-vm-ram
    echo "$DATE Full 32GB hugepage allocation. VM gets fixed RAM with 100% hugepage coverage."
fi

## Auto-start VNC Server for secondary access
echo "$DATE Checking/Starting VNC Remote..."
su - snekux -c "/usr/local/bin/vnc-remote start"

echo "$DATE Restarting CoolerControl for VM mode..."
systemctl --no-block restart coolercontrold.service

echo "$DATE End of Startup!"
