  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <!-- pit: 'discard' drops missed ticks instead of accumulating them.
         'delay' causes burst timer interrupt floods under heavy CPU load,
         which can overwhelm vCPU interrupt handling → CLOCK_WATCHDOG_TIMEOUT. -->
    <timer name='pit' tickpolicy='discard'/>
    <timer name='hpet' present='yes'/>
    <!-- tsc native: guest reads TSC directly from hardware, no VMEXIT needed.
         invtsc (in CPU features) guarantees the TSC rate is stable. -->
    <timer name='tsc' present='yes' mode='native'/>
    <timer name='hypervclock' present='yes'/>
  </clock>
