<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <!-- iothreads: 1 dedicated thread for virtio-scsi disk I/O, pinned to E-core 16.
       Offloads DirectStorage asset reads off the main QEMU thread / vCPU dispatch loop. -->
  <iothreads>1</iothreads>
  <name>win11</name>
  <uuid>ef432d48-176d-4fe4-a1c5-7987be730b5e</uuid>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>
  <memory unit='KiB'>33554432</memory>
  <currentMemory unit='KiB'>33554432</currentMemory>
  <memoryBacking>
    <!-- memfd + hugepages: 2MB hugepages are pre-reserved by vfio-startup hook
         (compact_memory + nr_hugepages=16384) BEFORE QEMU starts. This avoids
         the 3-min prealloc hang: kernel has already allocated+zeroed the pages,
         so QEMU's prealloc just maps pre-existing physical pages (near-instant).
         Required for virtiofs (vm-share) shared memory access. -->
    <hugepages>
      <page size='2048' unit='KiB'/>
    </hugepages>
    <source type='memfd'/>
    <access mode='shared'/>
    <allocation mode='immediate' threads='16'/>
  </memoryBacking>
  <vcpu placement='static'>16</vcpu>
  <cputune>
    <!-- P-core HT pairs: Linux CPUs 0+1=Core0, 2+3=Core1, 4+5=Core2, 6+7=Core3,
         8+9=Core4(5400MHz), 10+11=Core5(5400MHz), 12+13=Core6, 14+15=Core7
         vCPU pairs map to real HT siblings so guest topology matches host -->
    <vcpupin vcpu='0' cpuset='0'/>   <!-- Core 0, thread 0 -->
    <vcpupin vcpu='1' cpuset='1'/>   <!-- Core 0, thread 1 (real HT sibling) -->
    <vcpupin vcpu='2' cpuset='2'/>   <!-- Core 1, thread 0 -->
    <vcpupin vcpu='3' cpuset='3'/>   <!-- Core 1, thread 1 -->
    <vcpupin vcpu='4' cpuset='4'/>   <!-- Core 2, thread 0 -->
    <vcpupin vcpu='5' cpuset='5'/>   <!-- Core 2, thread 1 -->
    <vcpupin vcpu='6' cpuset='6'/>   <!-- Core 3, thread 0 -->
    <vcpupin vcpu='7' cpuset='7'/>   <!-- Core 3, thread 1 -->
    <vcpupin vcpu='8' cpuset='8'/>   <!-- Core 4, thread 0 (5400MHz!) -->
    <vcpupin vcpu='9' cpuset='9'/>   <!-- Core 4, thread 1 (5400MHz!) -->
    <vcpupin vcpu='10' cpuset='10'/> <!-- Core 5, thread 0 (5400MHz!) -->
    <vcpupin vcpu='11' cpuset='11'/> <!-- Core 5, thread 1 (5400MHz!) -->
    <vcpupin vcpu='12' cpuset='12'/> <!-- Core 6, thread 0 -->
    <vcpupin vcpu='13' cpuset='13'/> <!-- Core 6, thread 1 -->
    <vcpupin vcpu='14' cpuset='14'/> <!-- Core 7, thread 0 -->
    <vcpupin vcpu='15' cpuset='15'/> <!-- Core 7, thread 1 -->
    <emulatorpin cpuset='16-23'/>    <!-- E-cores: isolated from VM vCPUs -->
    <!-- iothread pinned to E-core 16, separate from emulator (17-23) to avoid contention -->
    <iothreadpin iothread='1' cpuset='16'/>
    <!-- FIFO real-time scheduling: vCPUs become essentially unpreemptable by host CFS tasks.
         Priority 1 (lowest RT) is sufficient to beat normal-priority host processes. -->
    <vcpusched vcpus='0-15' scheduler='fifo' priority='1'/>
    <iothreadsched iothreads='1' scheduler='fifo' priority='1'/>
  </cputune>
